POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis
MINIO_ROOT_USER=fluxor
MINIO_ROOT_PASSWORD=change-me-minio

# Optional: an admin API key installed at startup (flx_ + 43 base64url chars).
# Leave empty and create keys with `docker compose exec backend ./workflow-server apikey create`.
FLUXOR_BOOTSTRAP_ADMIN_KEY=

# Optional: the key that signs browser session cookies (base64, at least 32 bytes):
#   head -c 32 /dev/urandom | base64
# Leave empty and every backend restart logs everyone out of the UI.
FLUXOR_SESSION_SECRET=
# Set to true when a TLS-terminating proxy sits in front, so the cookie is marked Secure.
FLUXOR_COOKIE_SECURE=false

# Optional: Grafana admin password for `--profile observability`. Empty keeps
# Grafana's default (admin/admin); dashboards are viewable without logging in.
GRAFANA_ADMIN_PASSWORD=

# Optional: the key that encrypts workflow secrets (base64, exactly 32 bytes):
#   head -c 32 /dev/urandom | base64
# Leave empty to disable secrets. Changing it makes stored secrets unreadable.
FLUXOR_SECRETS_KEY=
